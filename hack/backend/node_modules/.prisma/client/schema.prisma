datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String
  phone                String?
  role                 String    @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  avatar               String?
  status               String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customerProfile   Customer?
  staffProfile      Staff?
  createdQuotations Quotation[]    @relation("CreatedQuotations")
  recordedPayments  Payment[]      @relation("RecordedPayments")
  activityLogs      ActivityLog[]
  notifications     Notification[]
}

model Customer {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerNumber  String   @unique
  companyName     String?
  contactName     String
  email           String
  phone           String
  billingAddress  String
  shippingAddress String?
  taxId           String? // GSTIN / Tax Identification
  currency        String   @default("INR")
  notes           String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions  Subscription[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  discountUsages DiscountUsage[]
}

model Staff {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId  String   @unique
  department  String
  designation String
  permissions String   @default("ALL") // JSON string or comma-separated permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  type        String   @default("SERVICE") // SERVICE, PHYSICAL, DIGITAL
  salesPrice  Float
  costPrice   Float
  description String?
  imageUrl    String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants          ProductVariant[]
  plans             Plan[]
  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  variantType     String // Brand, Edition, Category
  variantValue    String // e.g. Odoo, Enterprise
  additionalPrice Float    @default(0.0)
  sku             String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotationLines    QuotationLine[]
  subscriptionLines SubscriptionLine[]
  invoiceLines      InvoiceLine[]
}

model Plan {
  id                    String    @id @default(uuid())
  productId             String
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                  String
  code                  String    @unique
  description           String?
  basePrice             Float
  billingFrequency      String    @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  minQuantity           Int       @default(1)
  startAvailabilityDate DateTime  @default(now())
  endAvailabilityDate   DateTime?
  autoClose             Boolean   @default(false)
  earlyCancellation     Boolean   @default(true)
  pauseAllowed          Boolean   @default(true)
  renewalAllowed        Boolean   @default(true)
  status                String    @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  subscriptions  Subscription[]
  quotationLines QuotationLine[]
}

model QuotationTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  validityDays Int      @default(30)
  defaultNotes String?
  defaultTerms String?
  linesJson    String // JSON string of default items, plans, quantities
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quotation {
  id                      String   @id @default(uuid())
  quotationNumber         String   @unique
  customerId              String
  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById             String
  createdBy               User     @relation("CreatedQuotations", fields: [createdById], references: [id])
  status                  String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, EXPIRED, CANCELLED
  validityDate            DateTime
  subtotal                Float    @default(0.0)
  taxAmount               Float    @default(0.0)
  discountAmount          Float    @default(0.0)
  totalAmount             Float    @default(0.0)
  notes                   String?
  terms                   String?
  convertedSubscriptionId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  lines QuotationLine[]
}

model QuotationLine {
  id           String          @id @default(uuid())
  quotationId  String
  quotation    Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  planId       String?
  plan         Plan?           @relation(fields: [planId], references: [id])
  description  String?
  quantity     Int             @default(1)
  unitPrice    Float
  taxRate      Float           @default(0.0)
  discountRate Float           @default(0.0)
  lineTotal    Float
}

model Subscription {
  id                 String    @id @default(uuid())
  subscriptionNumber String    @unique
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  status             String    @default("ACTIVE") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED, CANCELLED, EXPIRED
  billingFrequency   String    @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  paymentTerms       String    @default("IMMEDIATE") // IMMEDIATE, NET_15, NET_30, NET_60
  startDate          DateTime  @default(now())
  expiryDate         DateTime
  nextBillingDate    DateTime?
  lastBilledDate     DateTime?
  pausedAt           DateTime?
  autoRenew          Boolean   @default(true)
  autoClose          Boolean   @default(false)
  subtotal           Float     @default(0.0)
  taxAmount          Float     @default(0.0)
  discountAmount     Float     @default(0.0)
  totalAmount        Float     @default(0.0)
  notes              String?
  quotationId        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lines            SubscriptionLine[]
  invoices         Invoice[]
  billingHistories BillingHistory[]
  activityLogs     ActivityLog[]
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  description    String?
  quantity       Int             @default(1)
  unitPrice      Float
  taxRate        Float           @default(0.0)
  discountRate   Float           @default(0.0)
  lineTotal      Float
}

model Tax {
  id                 String    @id @default(uuid())
  name               String
  code               String    @unique
  percentage         Float
  taxType            String    @default("GST") // GST, CGST, SGST, IGST
  applicableProducts String    @default("ALL") // "ALL" or comma-separated product IDs
  effectiveStart     DateTime  @default(now())
  effectiveEnd       DateTime?
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Discount {
  id                 String    @id @default(uuid())
  name               String
  code               String    @unique
  discountType       String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue      Float
  minPurchaseAmount  Float     @default(0.0)
  minQuantity        Int       @default(1)
  applicableProducts String    @default("ALL")
  maxUsageCount      Int?
  currentUsageCount  Int       @default(0)
  startDate          DateTime  @default(now())
  endDate            DateTime?
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  usages DiscountUsage[]
}

model DiscountUsage {
  id         String   @id @default(uuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId  String?
  amount     Float
  usedAt     DateTime @default(now())
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status             String        @default("CONFIRMED") // DRAFT, CONFIRMED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  subtotal           Float         @default(0.0)
  taxAmount          Float         @default(0.0)
  discountAmount     Float         @default(0.0)
  totalAmount        Float         @default(0.0)
  amountPaid         Float         @default(0.0)
  balanceDue         Float         @default(0.0)
  currency           String        @default("INR")
  notes              String?
  terms              String?
  pdfUrl             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lines            InvoiceLine[]
  payments         Payment[]
  billingHistories BillingHistory[]
}

model InvoiceLine {
  id           String          @id @default(uuid())
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  description  String?
  quantity     Int             @default(1)
  unitPrice    Float
  taxRate      Float           @default(0.0)
  discountRate Float           @default(0.0)
  lineTotal    Float
}

model Payment {
  id             String   @id @default(uuid())
  paymentNumber  String   @unique
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedById   String?
  recordedBy     User?    @relation("RecordedPayments", fields: [recordedById], references: [id])
  amount         Float
  paymentDate    DateTime @default(now())
  paymentMethod  String   @default("UPI") // UPI, CREDIT_CARD, DEBIT_CARD, NET_BANKING, BANK_TRANSFER, CASH
  transactionRef String?
  notes          String?
  status         String   @default("SUCCESS") // SUCCESS, FAILED, PENDING
  gatewayDetails String? // JSON response from Razorpay / Gateway
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BillingHistory {
  id                 String       @id @default(uuid())
  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceId          String?
  invoice            Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  status             String       @default("SUCCESS") // SUCCESS, FAILED
  amount             Float
  executedAt         DateTime     @default(now())
  errorMessage       String?
}

model ActivityLog {
  id             String        @id @default(uuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceId      String?
  action         String
  details        String
  ipAddress      String?
  createdAt      DateTime      @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
